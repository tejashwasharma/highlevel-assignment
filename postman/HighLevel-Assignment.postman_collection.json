    {
      "name": "Bulk Moves",
      "item": [
        {
          "name": "Submit Bulk Move",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('jobId', body.id);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-Id", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"status\": \"open\"\n  },\n  \"targetStageId\": \"{{stageBId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bulk-moves",
              "host": ["{{baseUrl}}"],
              "path": ["bulk-moves"]
            }
          },
          "response": []
        },
        {
          "name": "Submit Bulk Move - full filter example",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-Id", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"status\": \"open\",\n    \"owner\": \"alice\",\n    \"valueMin\": 1000,\n    \"valueMax\": 50000,\n    \"createdAfter\": \"2026-01-01T00:00:00Z\",\n    \"createdBefore\": \"2026-06-01T00:00:00Z\"\n  },\n  \"targetStageId\": \"{{stageBId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bulk-moves",
              "host": ["{{baseUrl}}"],
              "path": ["bulk-moves"]
            }
          },
          "response": []
        },
