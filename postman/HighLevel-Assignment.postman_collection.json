    {
      "name": "Opportunities",
      "item": [
        {
          "name": "Create Opportunity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('opportunityId', body.id);",
                  "  pm.environment.set('opportunityVersion', body.version);",
                  "}",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-Id", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp deal\",\n  \"value\": 15000,\n  \"status\": \"open\",\n  \"owner\": \"alice\",\n  \"stageId\": \"{{stageAId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/opportunities",
              "host": ["{{baseUrl}}"],
              "path": ["opportunities"]
            }
          },
          "response": []
        },
