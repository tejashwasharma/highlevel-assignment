{
  "name": "highlevel-assignment",
  "version": "0.1.0",
  "private": true,
  "description": "SDE-3 take-home: Bulk Stage Move (Opportunities pipeline engine)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && dotenv -e .env -- node dist/server.js",
    "start:worker": "tsc -p tsconfig.json && dotenv -e .env -- node dist/worker.js",
    "migrate": "dotenv -e .env -- node-pg-migrate --migrations-dir db/migrations up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate --migrations-dir db/migrations down",
    "test": "tsc -p tsconfig.json && dotenv -e .env -- jest --runInBand"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2"
  }
}
